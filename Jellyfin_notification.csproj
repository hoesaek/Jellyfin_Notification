<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Jellyfin_notification</AssemblyName>
    <RootNamespace>Jellyfin_notification</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.3.0.0</Version>
    <Authors>Jellyfin</Authors>
    <Description>Système de notifications personnalisées pour Jellyfin — envoi ciblé, push WebSocket, cloche native, historique admin.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.8">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.8">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- SQLite.Core = pas de native bundle → utilise le sqlite3 déjà chargé par Jellyfin -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Ressources embarquées dans la DLL -->
  <ItemGroup>
    <None Remove="Pages\send.html" />
    <EmbeddedResource Include="Pages\send.html" />

    <None Remove="Pages\history.html" />
    <EmbeddedResource Include="Pages\history.html" />

    <None Remove="ClientScript\notif-client.js" />
    <EmbeddedResource Include="ClientScript\notif-client.js" />
  </ItemGroup>

</Project>
